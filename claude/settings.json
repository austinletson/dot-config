{
  "permissions": {
    "allow": [
      "mcp__lean-lsp__*",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enabledPlugins": {
    "lean@leanprover": true
  },
  "extraKnownMarketplaces": {
    "lean4-skills": {
      "source": {
        "source": "github",
        "repo": "cameronfreer/lean4-skills"
      }
    },
    "leanprover": {
      "source": {
        "source": "git",
        "url": "https://github.com/leanprover/skills.git"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "alwaysThinkingEnabled": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true
}
